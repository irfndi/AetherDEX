{
  "name": "@aetherdex/alchemy-infra",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "plan:dev": "alchemy plan --stage dev_$USER",
    "deploy:dev": "alchemy deploy --stage dev_$USER --adopt --yes",
    "deploy:staging": "alchemy deploy --stage staging --adopt --yes",
    "web:build": "cd ../../apps/web && bun run build",
    "web:deploy:dev": "cd ../../apps/web && bun run build && bunx wrangler pages deploy dist --project-name aetherdex-web-dev --commit-dirty=true",
    "web:deploy:staging": "cd ../../apps/web && bun run build && bunx wrangler pages deploy dist --project-name aetherdex-web-staging --commit-dirty=true",
    "destroy:dev": "alchemy destroy --stage dev_$USER"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "@effect/platform-bun": ">=4.0.0-beta.100 || >=4.0.0",
    "@effect/platform-node": ">=4.0.0-beta.100 || >=4.0.0",
    "alchemy": "2.0.0-beta.64",
    "effect": ">=4.0.0-beta.100 || >=4.0.0"
  }
}

{
  "name": "@aetherdex/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsr generate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "predeploy": "bun run build",
    "deploy": "wrangler pages deploy dist --project-name aether",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.provider=istanbul",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@aetherdex/shared": "workspace:*",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@tanstack/react-form": "^1.33.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@uniswap/sdk-core": "^7.19.0",
    "@uniswap/v3-sdk": "^3.31.1",
    "@uniswap/v4-sdk": "^2.3.1",
    "@wagmi/core": "^3.6.4",
    "daisyui": "^5.7.16",
    "effect": "4.0.0-beta.100",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.13",
    "wagmi": "^3.7.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-cli": "^1.167.27",
    "@tanstack/router-plugin": "^1.168.29",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "happy-dom": "^20.11.2",
    "postcss": "^8.5.26",
    "react-doctor": "^0.9.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  }
}

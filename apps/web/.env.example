# Backend API URL
VITE_API_URL=http://localhost:8080/api/v1

# HTTPS private transaction endpoint; swaps remain disabled when unset
VITE_PRIVATE_RPC_URL=https://private-rpc.example

# Deployment chain and AetherRouter address used for protected liquidity transactions
VITE_CHAIN_ID=11155111
VITE_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_POSITION_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_V3_ZAP_EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000
VITE_V3_POSITION_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# Reown AppKit project ID (https://cloud.reown.com)
VITE_REOWN_PROJECT_ID=YOUR_PROJECT_ID_HERE

# Production (set at deploy time)
# VITE_API_URL=https://api.aetherdex.io/api/v1
# VITE_REOWN_PROJECT_ID=cd2a3...actual_project_id

# Backend API URL
VITE_API_URL=http://localhost:8080/api/v1

# HTTPS private transaction endpoint; swaps remain disabled when unset
VITE_PRIVATE_RPC_URL=https://private-rpc.example

# Reown AppKit project ID (https://cloud.reown.com)
VITE_REOWN_PROJECT_ID=YOUR_PROJECT_ID_HERE

# Production (set at deploy time)
# VITE_API_URL=https://api.aetherdex.io/api/v1
# VITE_REOWN_PROJECT_ID=cd2a3...actual_project_id

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aetherdex-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0 // 100% sampling for low-traffic DEX
  },

  // D1 Database — active pools, orders, users
  // Run `bun run d1:create` and update database_id
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aetherdex-main",
      "database_id": "REPLACE_WITH_OUTPUT_FROM_d1:create",
      "migrations_dir": "migrations"
    }
  ],

  // Workers KV — hot cache (prices, sessions)
  // Run `bun run kv:create` and update id
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_OUTPUT_FROM_kv:create"
    }
  ],

  // R2 Bucket — trade history archives
  // Run `bun run r2:create` and update bucket_name
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "aetherdex-storage"
    }
  ],

  // Durable Objects — WebSocket state, per-pair order book, SIWE nonce authority
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_BOOK",
        "class_name": "OrderBookDO"
      },
      {
        "name": "WEBSOCKET_HUB",
        "class_name": "WebSocketHubDO"
      },
      {
        "name": "SIWE_NONCE",
        "class_name": "SiweNonceDO"
      },
      {
        "name": "VOLUME_ALERT_HUB",
        "class_name": "VolumeAlertHubDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrderBookDO", "WebSocketHubDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SiweNonceDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["VolumeAlertHubDO"]
    }
  ],

  // Background queues
  "queues": {
    "producers": [
      { "queue": "price-refresh", "binding": "PRICE_QUEUE" },
      { "queue": "trade-settlement", "binding": "SETTLE_QUEUE" },
      { "queue": "keeper-jobs", "binding": "KEEPER_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "price-refresh",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "price-refresh-dlq"
      },
      {
        "queue": "trade-settlement",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "trade-settlement-dlq"
      },
      {
        "queue": "keeper-jobs",
        "max_batch_size": 5,
        "max_retries": 5,
        "dead_letter_queue": "keeper-jobs-dlq"
      }
    ]
  },

  // Scheduled tasks
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Environment variables (non-secret)
  // Contract addresses are deployment config (owner RPC), never hardcoded in source.
  // Phase 4 (#314): every address below is filled from the output of
  // `forge script script/Deploy.s.sol ... --broadcast` — see the Deployment Summary it logs.
  // The treasury multisig (TREASURY_ADDRESS) is config, NOT a secret: it is baked into the
  // on-chain contracts at deploy time and only recorded here for deployment traceability.
  "vars": {
    "CHAIN_ID": "11155111",
    "SIWE_DOMAIN": "aetherdex.io",
    "SIWE_URI": "https://aetherdex.io",
    // Phase 4 (#314) — from Deploy.s.sol summary: ROUTER_ADDRESS, FACTORY_ADDRESS,
    // POSITION_MANAGER_ADDRESS, AETHER_HOOK_ADDRESS, POOL_MANAGER_ADDRESS, TREASURY_ADDRESS.
    "ROUTER_ADDRESS": "",
    "FACTORY_ADDRESS": "", // Sepolia for now
    // AETHER_HOOK_ADDRESS (#314): the AetherHook oracle the keeper reads for TWAP-gated TP/SL.
    // Passed to the keeper queue env (see src/index.ts) alongside RPC_URL; empty keeps TWAP
    // reads disabled until configured.
    "AETHER_HOOK_ADDRESS": "",
    // V3 zap executor (DeployV3.s.sol output) — informational deployment record.
    "V3_EXECUTOR_ADDRESS": "",
    // TREASURY_ADDRESS (#314): the immutable 0.1% fee treasury multisig — recorded for
    // traceability only; the fee accrues on-chain, the API never spends from it.
    "TREASURY_ADDRESS": "",
    // Uniswap V4 on-chain read config for the quote engine (Phase-0 G2). Empty until G5 wires them.
    "STATE_VIEW_ADDRESS": "",
    "POOL_MANAGER_ADDRESS": "",
    "V3_FACTORY_ADDRESS": "",
    "V3_QUOTER_ADDRESS": "",
    "POSITION_MANAGER_ADDRESS": "",
    "V3_POSITION_MANAGER_ADDRESS": "",
    "V3_POSITION_MANAGER_DEPLOYMENT_BLOCK": "0",
    "RPC_URL": "",
    // Phase 3 indexer — disabled until explicitly enabled with INDEXER_ENABLED=true
    // and at least one source contract address below. Comma list for V3 pools.
    "INDEXER_ENABLED": "false",
    "INDEXER_BATCH_SIZE": "2000",
    "V4_POOL_MANAGER_ADDRESS": "",
    "V3_INDEXED_POOL_ADDRESSES": "",
    // Phase 2/3 keeper relayer (src/lib/keeper-signer.ts). Submission stays
    // EVALUATION-ONLY until PRIVATE_TX_RELAY_URL is set (https MEV Tier-B relay;
    // preferred) or KEEPER_ALLOW_PUBLIC_SUBMISSION is explicitly "true".
    // Secrets KEEPER_PRIVATE_KEY + KEEPER_RPC_URL go via `wrangler secret put`.
    "TPSL_ADDRESS": "",
    "AETHER_TPSL_ADDRESS": "",
    "KEEPER_ALLOW_PUBLIC_SUBMISSION": "false",
    "KEEPER_MIN_BALANCE_ETH": "0.05",
    "KEEPER_MAX_GAS_PRICE_GWEI": "",
    // "auto" = V4 tick-math when STATE_VIEW_ADDRESS+RPC_URL are set, else legacy D1 approximation.
    "QUOTE_ENGINE_MODE": "auto",
    // Canonical Uniswap default token list (Phase-0 G4) — the only token list AetherDEX serves.
    "TOKEN_LIST_URL": "https://tokens.uniswap.org",
    // Phase-3 API safety suite (src/middleware/*) — parsed with safe fallbacks in src/lib/safety-config.ts.
    "RATE_LIMIT_MAX": "60",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
    "CIRCUIT_FAILURE_THRESHOLD": "5",
    "CIRCUIT_COOLDOWN_SECONDS": "30",
    "HIGH_VALUE_USD_THRESHOLD": "10000",
    // MEV protection: off | client | private. "private" degrades to "client" until PRIVATE_TX_RELAY_URL is set.
    "MEV_PROTECTION_MODE": "client",
    "MEV_MAX_SLIPPAGE_BPS": "500",
    "PRIVATE_TX_RELAY_URL": "",
    // Phase-3 volume-spike alerts — enabled with conservative defaults; the tick
    // reads these in src/services/volume-alerts.service.ts (invalid values fall back).
    "VOLUME_ALERT_WINDOW_SECONDS": "300",
    "VOLUME_ALERT_THRESHOLD_USD": "1000000",
    "VOLUME_ALERT_COOLDOWN_SECONDS": "900",
    "ENVIRONMENT": "development"
  },

  // Phase 2/3 keeper relayer secrets (set via `wrangler secret put`):
  //   KEEPER_PRIVATE_KEY — hex-encoded private key; loaded for local signing only, never logged
  //   KEEPER_RPC_URL — RPC endpoint used for preflight reads + public submission when enabled
  // Submission stays evaluation-only unless PRIVATE_TX_RELAY_URL (https-only,
  // MEV Tier-B private relay; preferred) or KEEPER_ALLOW_PUBLIC_SUBMISSION="true".
  //
  // Phase 3 volume-alert Telegram notifications (set via `wrangler secret put`):
  //   TELEGRAM_BOT_TOKEN — bot API token; alerts stay off until this is set
  //   TELEGRAM_CHAT_ID — destination chat id; both are required to enable sends

  // Environments
  "env": {
    "staging": {
      "name": "aetherdex-api-staging",
      "vars": {
        "CHAIN_ID": "11155111",
        "SIWE_DOMAIN": "localhost",
        "SIWE_URI": "http://localhost:3000",
        "ROUTER_ADDRESS": "",
        "FACTORY_ADDRESS": "",
        // Phase 4 (#314) — fill from Deploy.s.sol summary on the staging network.
        "AETHER_HOOK_ADDRESS": "",
        "V3_EXECUTOR_ADDRESS": "",
        "TREASURY_ADDRESS": "",
        "STATE_VIEW_ADDRESS": "",
        "POOL_MANAGER_ADDRESS": "",
        "V3_FACTORY_ADDRESS": "",
        "V3_QUOTER_ADDRESS": "",
        "POSITION_MANAGER_ADDRESS": "",
        "V3_POSITION_MANAGER_ADDRESS": "",
        "V3_POSITION_MANAGER_DEPLOYMENT_BLOCK": "0",
        "RPC_URL": "",
        "INDEXER_ENABLED": "false",
        "INDEXER_BATCH_SIZE": "2000",
        "V4_POOL_MANAGER_ADDRESS": "",
        "V3_INDEXED_POOL_ADDRESSES": "",
        "TPSL_ADDRESS": "",
        "AETHER_TPSL_ADDRESS": "",
        "KEEPER_ALLOW_PUBLIC_SUBMISSION": "false",
        "KEEPER_MIN_BALANCE_ETH": "0.05",
        "KEEPER_MAX_GAS_PRICE_GWEI": "",
        "QUOTE_ENGINE_MODE": "auto",
        "TOKEN_LIST_URL": "https://tokens.uniswap.org",
        "RATE_LIMIT_MAX": "60",
        "RATE_LIMIT_WINDOW_SECONDS": "60",
        "CIRCUIT_FAILURE_THRESHOLD": "5",
        "CIRCUIT_COOLDOWN_SECONDS": "30",
        "HIGH_VALUE_USD_THRESHOLD": "10000",
        "MEV_PROTECTION_MODE": "client",
        "MEV_MAX_SLIPPAGE_BPS": "500",
        "PRIVATE_TX_RELAY_URL": "",
        "VOLUME_ALERT_WINDOW_SECONDS": "300",
        "VOLUME_ALERT_THRESHOLD_USD": "1000000",
        "VOLUME_ALERT_COOLDOWN_SECONDS": "900",
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aetherdex-main-staging",
          "database_id": "REPLACE_WITH_OUTPUT_FROM_d1:create_staging",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "REPLACE_WITH_OUTPUT_FROM_kv:create_staging"
        }
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "aetherdex-storage-staging"
        }
      ],
      "queues": {
        "producers": [
          { "queue": "price-refresh-staging", "binding": "PRICE_QUEUE" },
          { "queue": "trade-settlement-staging", "binding": "SETTLE_QUEUE" },
          { "queue": "keeper-jobs-staging", "binding": "KEEPER_QUEUE" }
        ],
        "consumers": [
          {
            "queue": "price-refresh-staging",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "price-refresh-staging-dlq"
          },
          {
            "queue": "trade-settlement-staging",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "trade-settlement-staging-dlq"
          },
          {
            "queue": "keeper-jobs-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 10,
            "dead_letter_queue": "keeper-jobs-staging-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          { "name": "ORDER_BOOK", "class_name": "OrderBookDO" },
          { "name": "WEBSOCKET_HUB", "class_name": "WebSocketHubDO" },
          { "name": "SIWE_NONCE", "class_name": "SiweNonceDO" },
          { "name": "VOLUME_ALERT_HUB", "class_name": "VolumeAlertHubDO" }
        ]
      }
    },
    "production": {
      "name": "aetherdex-api-prod",
      "vars": {
        "CHAIN_ID": "1",
        "SIWE_DOMAIN": "aetherdex.io",
        "SIWE_URI": "https://aetherdex.io",
        "ROUTER_ADDRESS": "",
        "FACTORY_ADDRESS": "",
        // Phase 4 (#314) — fill from Deploy.s.sol summary on the production network.
        "AETHER_HOOK_ADDRESS": "",
        "V3_EXECUTOR_ADDRESS": "",
        "TREASURY_ADDRESS": "",
        "STATE_VIEW_ADDRESS": "",
        "POOL_MANAGER_ADDRESS": "",
        "V3_FACTORY_ADDRESS": "",
        "V3_QUOTER_ADDRESS": "",
        "POSITION_MANAGER_ADDRESS": "",
        "V3_POSITION_MANAGER_ADDRESS": "",
        "V3_POSITION_MANAGER_DEPLOYMENT_BLOCK": "0",
        "RPC_URL": "",
        "INDEXER_ENABLED": "false",
        "INDEXER_BATCH_SIZE": "2000",
        "V4_POOL_MANAGER_ADDRESS": "",
        "V3_INDEXED_POOL_ADDRESSES": "",
        "TPSL_ADDRESS": "",
        "AETHER_TPSL_ADDRESS": "",
        "KEEPER_ALLOW_PUBLIC_SUBMISSION": "false",
        "KEEPER_MIN_BALANCE_ETH": "0.05",
        "KEEPER_MAX_GAS_PRICE_GWEI": "",
        "QUOTE_ENGINE_MODE": "auto",
        "TOKEN_LIST_URL": "https://tokens.uniswap.org",
        "RATE_LIMIT_MAX": "60",
        "RATE_LIMIT_WINDOW_SECONDS": "60",
        "CIRCUIT_FAILURE_THRESHOLD": "5",
        "CIRCUIT_COOLDOWN_SECONDS": "30",
        "HIGH_VALUE_USD_THRESHOLD": "10000",
        "MEV_PROTECTION_MODE": "client",
        "MEV_MAX_SLIPPAGE_BPS": "500",
        "PRIVATE_TX_RELAY_URL": "",
        "VOLUME_ALERT_WINDOW_SECONDS": "300",
        "VOLUME_ALERT_THRESHOLD_USD": "1000000",
        "VOLUME_ALERT_COOLDOWN_SECONDS": "900",
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aetherdex-main-production",
          "database_id": "REPLACE_WITH_OUTPUT_FROM_d1:create_production",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "REPLACE_WITH_OUTPUT_FROM_kv:create_production"
        }
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "aetherdex-storage-production"
        }
      ],
      "queues": {
        "producers": [
          { "queue": "price-refresh-production", "binding": "PRICE_QUEUE" },
          { "queue": "trade-settlement-production", "binding": "SETTLE_QUEUE" },
          { "queue": "keeper-jobs-production", "binding": "KEEPER_QUEUE" }
        ],
        "consumers": [
          {
            "queue": "price-refresh-production",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "price-refresh-production-dlq"
          },
          {
            "queue": "trade-settlement-production",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "trade-settlement-production-dlq"
          },
          {
            "queue": "keeper-jobs-production",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 10,
            "dead_letter_queue": "keeper-jobs-production-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          { "name": "ORDER_BOOK", "class_name": "OrderBookDO" },
          { "name": "WEBSOCKET_HUB", "class_name": "WebSocketHubDO" },
          { "name": "SIWE_NONCE", "class_name": "SiweNonceDO" },
          { "name": "VOLUME_ALERT_HUB", "class_name": "VolumeAlertHubDO" }
        ]
      }
    }
  }
}
